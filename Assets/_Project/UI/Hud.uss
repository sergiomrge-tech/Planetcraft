/* Return to Earth — visor do traje: tipografia técnica condensada, molduras finas com cantoneiras, âmbar de sinal. */

.rte-root {
    -unity-font-definition: url("Fonts/Rajdhani-SemiBold.ttf");
    color: rgb(238, 232, 218);
}

.rte-root Label,
.rte-root Button,
.rte-root TextElement {
    -unity-font-definition: url("Fonts/Rajdhani-SemiBold.ttf");
}

.rte-root .rte-strong {
    -unity-font-definition: url("Fonts/Rajdhani-Bold.ttf");
}

.rte-root .rte-mono {
    -unity-font-definition: url("Fonts/ShareTechMono-Regular.ttf");
}

.rte-root .rte-tag {
    -unity-font-definition: url("Fonts/Rajdhani-Bold.ttf");
    letter-spacing: 3px;
    font-size: 11px;
    color: rgb(150, 156, 150);
}

/* Botões: contorno âmbar, sem preenchimento cinza padrão. */
.rte-button {
    background-color: rgba(255, 184, 72, 0.05);
    border-width: 1px;
    border-color: rgba(255, 184, 72, 0.45);
    border-radius: 0;
    color: rgb(238, 232, 218);
    -unity-font-definition: url("Fonts/Rajdhani-Bold.ttf");
    letter-spacing: 1.5px;
    padding: 3px 12px;
    margin: 2px 0 2px 6px;
    transition-duration: 0.12s;
}

.rte-button:hover,
.rte-button:focus {
    background-color: rgba(255, 184, 72, 0.2);
    border-color: rgb(255, 184, 72);
    color: rgb(255, 255, 255);
}

.rte-button:active {
    background-color: rgba(255, 184, 72, 0.38);
}

.rte-button:disabled {
    background-color: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.12);
    color: rgba(238, 232, 218, 0.35);
    opacity: 1;
}

.rte-button--big {
    -unity-text-align: middle-left;
    padding-left: 18px;
    margin: 4px 0;
}

/* Barras de rolagem discretas. */
.rte-root .unity-scroller--vertical {
    width: 6px;
}

.rte-root .unity-scroller__low-button,
.rte-root .unity-scroller__high-button {
    display: none;
}

.rte-root .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0;
}

.rte-root .unity-base-slider__dragger {
    background-color: rgb(255, 184, 72);
    border-width: 0;
    border-radius: 0;
    width: 4px;
}

/* Campos das opções (listas, números, caixas de seleção) no tom do visor, sem o branco do tema padrão. */
.rte-root .unity-base-popup-field__input,
.rte-root .unity-base-text-field__input,
.rte-root .unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 184, 72, 0.45);
    border-radius: 0;
    color: rgb(238, 232, 218);
}

.rte-root .unity-base-popup-field__text,
.rte-root .unity-text-element {
    color: rgb(238, 232, 218);
}

.rte-root .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(255, 184, 72);
}
